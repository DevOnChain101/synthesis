{
  "cwd": "<TMP>/ws",
  "env": {},
  "files": {
    "<HOME>/.synt/settings.json": {
      "hooks": {
        "PreToolUse": [
          {
            "hooks": [
              {
                "command": "echo user",
                "type": "command"
              }
            ],
            "matcher": "Bash"
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "command": "echo stop",
                "type": "command"
              }
            ]
          }
        ]
      }
    },
    "<TMP>/ws/.synt/settings.json": {
      "hooks": {
        "PreToolUse": [
          {
            "hooks": [
              {
                "command": "echo project",
                "type": "command"
              }
            ],
            "matcher": "Bash"
          }
        ]
      }
    }
  },
  "op": "workspace"
}
