{
  "cwd": "<TMP>/ws",
  "env": {
    "SYNT_DEFAULT_CUSTOM_MODEL": "gateway/c-9",
    "SYNT_DEFAULT_OPUS_MODEL": "gateway/o-9",
    "SYNT_DEFAULT_SONNET_MODEL": "gateway/s-9"
  },
  "files": {
    "<SYNT_HOME>/synt.json": {
      "$schema": "config.json/v1",
      "aliases": {
        "opus": "anthropic/claude-opus-1"
      }
    }
  },
  "home": "<SYNT_HOME>",
  "op": "loadConfig"
}
