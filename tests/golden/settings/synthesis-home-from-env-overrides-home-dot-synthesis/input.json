{
  "cwd": "<TMP>/ws",
  "env": {
    "SYNT_HOME": "<SYNT_HOME>"
  },
  "files": {
    "<HOME>/.synt/settings.json": {
      "permissions": {
        "allow": [
          "DotSynthesis"
        ]
      }
    },
    "<SYNT_HOME>/settings.json": {
      "permissions": {
        "allow": [
          "FromSynthesisHome"
        ]
      }
    }
  },
  "op": "workspace"
}
