{
  "cwd": "<TMP>/ws",
  "env": {},
  "files": {
    "<HOME>/.synt/synt.json": {
      "claude": {
        "readUserConfig": true
      }
    },
    "<HOME>/.synt/settings.json": {
      "disabledMcpjsonServers": [
        "remote"
      ],
      "enabledMcpjsonServers": [
        "alpha"
      ]
    },
    "<TMP>/ws/.mcp.json": {
      "mcpServers": {
        "alpha": {
          "args": [
            "a.js"
          ],
          "command": "node",
          "env": {
            "SECRET": "x"
          }
        },
        "remote": {
          "headers": {
            "Authorization": "Bearer z"
          },
          "type": "http",
          "url": "https://user:pw@h.example.test/mcp?token=abc"
        }
      }
    }
  },
  "op": "workspace"
}
