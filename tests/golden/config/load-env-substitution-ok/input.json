{
  "cwd": "<TMP>/ws",
  "env": {
    "MY_HDR": "h",
    "MY_KEY": "sk-from-env"
  },
  "files": {
    "<SYNT_HOME>/synt.json": {
      "$schema": "config.json/v1",
      "providers": {
        "p": {
          "apiKey": "{env:MY_KEY}",
          "headers": {
            "Auth": "{env:MY_HDR}"
          },
          "type": "openai"
        }
      }
    }
  },
  "home": "<SYNT_HOME>",
  "op": "loadConfig"
}
